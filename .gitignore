# ============================================================
# Runtime-generated volume data — never commit these
# ============================================================

# Pi-hole data (gravity DB, FTL DB, TLS certs, list cache, etc.)
testing/etc-pihole/

# dnsmasq configs generated by _cachedomainsonboot.sh on every start
testing/etc-dnsmasq.d/

# uklans/cache-domains clone artifacts
testing/cache-domains/*.txt
testing/cache-domains/cache_domains.json
testing/cache-domains/scripts/
# Keep our pre-configured lancache config file
!testing/cache-domains/config/
!testing/cache-domains/config/config.json

# ============================================================
# Authored test configs — keep these (explicit un-ignore)
# ============================================================
# testing/config/dnsproxy.yml              — our testing override
# testing/config/dnsproxy-doh-only.yml    — Scenario H: DoH-only test
# testing/config/dnsproxy-dot-only.yml    — Scenario H-home: DoT-only test (home network)
# testing/pihole-updatelists/pihole-updatelists.conf — Scenario B file-based config
# testing/cache-domains/config/config.json — Scenario C pre-configured lancache IP
# testing/docker-compose.yml
# testing/docker-compose.file-config.yml
# examples/                               — all reference compose files

# ============================================================
# General
# ============================================================
.DS_Store
*.log
*.bak

# Personal git setup notes — local only, not for public repo
GIT-SETUP.md

# Local testing infrastructure — not needed by end users
testing/
